<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mango.dao.TableDao">
    <select id="getAllTable" resultType="Table">
        SELECT * FROM reservation_demo.table
    </select>

    <insert id="addTable" parameterType="table">
        INSERT INTO reservation_demo.table
        (id, classroom_id, name)
        VALUES
            (#{id}, #{classroom_id}, #{name})
    </insert>
</mapper>